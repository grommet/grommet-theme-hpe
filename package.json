{
  "name": "grommet-theme-hpe",
  "version": "8.1.4",
  "main": "dist/index.js",
  "module": "dist/es6/index.js",
  "jsnext:main": "dist/es6/index.js",
  "sideEffects": false,
  "description": "Hewlett Packard Enterprise theme for grommet",
  "authors": [
    "Alan Souza",
    "Bryan Jacquot",
    "Chris Carlozzi",
    "Eric Soderberg",
    "Shimrit (Shimi) Yacobi"
  ],
  "bugs": "https://github.com/grommet/grommet-theme-hpe/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/grommet/grommet-theme-hpe.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "grommet": "^2.50.0",
    "react": "^16.13.1 || ^17.0.1 || ^18.0.0 || ^19.0.0",
    "styled-components": "^6.0.0"
  },
  "dependencies": {
    "@hpe-design/icons-grommet": "^1.1.0",
    "hpe-design-tokens": "^2.2.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.1",
    "@babel/core": "^7.24.4",
    "@babel/eslint-parser": "^7.24.1",
    "@babel/node": "^7.23.9",
    "@babel/preset-env": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@changesets/cli": "^2.28.1",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-links": "^10.5.4",
    "@storybook/addon-themes": "^10.5.4",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
    "@storybook/react-webpack5": "^10.5.4",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "del": "^6.1.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-babel": "^5.3.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "fs-extra": "^11.2.0",
    "grommet": "^2.55.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.5",
    "pretty-quick": "^4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-git": "^3.24.0",
    "storybook": "^10.5.4",
    "styled-components": "^6.0.0",
    "stylis": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "prepare": "husky",
    "generate-version": "babel-node ./tools/generate-version",
    "test": "npm run generate-version && jest",
    "storybook": "npm run generate-version && storybook dev -p 6006",
    "build-storybook": "npm run generate-version && storybook build",
    "prepublishOnly": "npm run build && npm run jsonify",
    "build": "npm run generate-version && webpack --mode production && cross-env babel ./src/js/ --out-dir ./dist --copy-files && cross-env BABEL_ENV=es6 babel ./src/js/ --out-dir ./dist/es6 --copy-files",
    "lint": "eslint src",
    "lint-fix": "eslint src --fix",
    "license": "node ./tools/license-header.js",
    "license-check": "node ./tools/license-header.js --check",
    "license-staged": "node ./tools/license-header.js --staged",
    "prettier": "pretty-quick --staged",
    "release-stable": "babel-node ./tools/release-stable --branch=stable",
    "release-next-stable": "babel-node ./tools/release-stable --branch=NEXT-stable",
    "release-audit-stable": "babel-node ./tools/release-stable --branch=AUDIT-stable",
    "release-tokens-stable": "babel-node ./tools/release-stable --branch=TOKENS-stable",
    "release-v2-alpha-stable": "babel-node ./tools/release-stable --branch=v2-alpha-stable",
    "release-hpe-design-tokens-v2-stable": "babel-node ./tools/release-stable --branch=hpe-design-tokens-v2-stable",
    "jsonify": "babel-node ./tools/convert-to-json > dist/grommet-theme-hpe.json",
    "release-gh-pages": "babel-node ./tools/release-gh-pages"
  }
}
